<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>me.psikuvit</groupId>
        <artifactId>betterwarden-parent</artifactId>
        <version>1.0</version>
    </parent>

    <artifactId>warden-paper</artifactId>
    <packaging>jar</packaging>

    <name>warden-paper</name>
    <description>Paper plugin: embeds warden-core (HOST mode), Bukkit-facing commands/GUIs/listeners.</description>

    <build>
        <finalName>BetterWarden${warden.jarSuffix}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <minimizeJar>false</minimizeJar>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>**/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <relocations>
                                <relocation>
                                    <pattern>org.yaml.snakeyaml</pattern>
                                    <shadedPattern>me.psikuvit.betterWarden.libs.snakeyaml</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.google.common</pattern>
                                    <shadedPattern>me.psikuvit.betterWarden.libs.guava</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.google.gson</pattern>
                                    <shadedPattern>me.psikuvit.betterWarden.libs.gson</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>io.netty</pattern>
                                    <shadedPattern>me.psikuvit.betterWarden.libs.netty</shadedPattern>
                                </relocation>
                                <!-- Do NOT relocate org.slf4j here: getSLF4JLogger() returns Paper's own
                                     unrelocated org.slf4j.Logger, so relocating the type makes every call
                                     site expect a different class than what Paper actually returns -
                                     NoSuchMethodError at runtime (same root cause as warden-velocity's
                                     Guice DI bug, found the same way: booting a real server). -->
                                <relocation>
                                    <pattern>com.fasterxml.jackson</pattern>
                                    <shadedPattern>me.psikuvit.betterWarden.libs.jackson</shadedPattern>
                                </relocation>
                                <!-- Do NOT relocate tools.jackson (Jackson 3.x, what Spring Boot 4's own
                                     JacksonAutoConfiguration builds its ObjectMapper bean from): found via
                                     a real HOST-mode boot on plain Spigot (server1-3 are all CLIENT mode,
                                     so this had never actually run before) - Spring's Jackson
                                     autoconfiguration gates itself on tools.jackson.databind.ObjectMapper
                                     via a STRING-based classpath check (@ConditionalOnClass(name = "...")),
                                     which shade's relocation does not rewrite (it only rewrites real class
                                     references, not string literals). Relocating the package silently made
                                     Spring think the class was absent and skip creating the ObjectMapper
                                     bean entirely - NoSuchBeanDefinitionException for
                                     NodeWebSocketHandler's constructor, not a NoSuchMethodError, which is
                                     why compiling clean and booting on Paper's CLIENT-mode servers never
                                     caught it. No known collision risk leaving this unrelocated - it's a
                                     brand-new Jackson 3.x package no other plugin bundles yet. -->
                                <relocation>
                                    <pattern>org.apache.commons</pattern>
                                    <shadedPattern>me.psikuvit.betterWarden.libs.commons</shadedPattern>
                                </relocation>
                                <!-- Do NOT relocate net.kyori (Adventure) or org.slf4j either, same
                                     reasoning as above: on Paper, parent-first classloading means the
                                     server's own already-loaded copies win and these bundled ones sit
                                     unused; on plain Spigot (which has neither on its own classpath at
                                     all - see WardenSpigotPlugin under spigot/), the plugin's own
                                     bundled unrelocated copies are what actually get loaded. Relocating
                                     either would break the Spigot path, which needs to construct real
                                     Adventure/slf4j-jdk14 instances of the same types this jar's own
                                     Paper-path code compiles against. -->
                            </relocations>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/spring.factories</resource>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/spring/org.springframework.boot.autoconfigure.AutoConfiguration.imports</resource>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <excludes>
                    <exclude>default-config.yml</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>default-config.yml</include>
                </includes>
            </resource>
        </resources>
    </build>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>26.2.build.121-stable</version>
            <scope>provided</scope>
        </dependency>

        <!-- Plain-Spigot support (me.psikuvit.betterWarden.spigot, formerly the separate
             warden-spigot module - merged so one jar boots correctly on either platform: Paper
             only ever reads paper-plugin.yml, plain Spigot/Bukkit only ever reads plugin.yml
             (both ship in this jar's resources, each naming its own already-independent main
             class), so which one "boots" is decided by the server's own loader, not by any
             runtime detection code here. paper-api is a superset of spigot-api for the plain
             Bukkit surface these classes use, so no separate spigot-api dependency is needed. -->
        <dependency>
            <!-- No native Adventure on Spigot at all, unlike Paper - this bridges MiniMessage output to Player#sendMessage. Deliberately NOT provided/relocated - see the shade config above. -->
            <groupId>net.kyori</groupId>
            <artifactId>adventure-platform-bukkit</artifactId>
            <version>4.4.1</version>
        </dependency>
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-text-minimessage</artifactId>
            <version>4.21.0</version>
        </dependency>
        <dependency>
            <!-- JavaPlugin#getLogger() on plain Spigot returns java.util.logging.Logger, not SLF4J
                 (Paper's JavaPlugin adds getSLF4JLogger(), Spigot's doesn't) - binds
                 org.slf4j.LoggerFactory to JUL so RemoteCoreClient/WriteJournal's Logger param
                 works unchanged in the Spigot path's CLIENT mode. -->
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-jdk14</artifactId>
            <version>2.0.18</version>
        </dependency>

        <dependency>
            <groupId>me.psikuvit</groupId>
            <artifactId>warden-core</artifactId>
        </dependency>

        <!-- Soft-depends: never on the classpath unless the actual plugin is installed on
             the server, so every reference to these types is guarded by a presence check
             before first use (see hook/) - otherwise a missing plugin means NoClassDefFoundError. -->
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.luckperms</groupId>
            <artifactId>api</artifactId>
            <version>5.5</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
