# Copy to .env and fill in real values - docker-compose.yml reads this automatically.
# Never commit the real .env.

MYSQL_DATABASE=warden
MYSQL_USER=warden
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme-root

# Host port the core's panel/API is published on (container always listens on 8095 internally).
WARDEN_PANEL_PORT=8095
